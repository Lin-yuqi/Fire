CompileFlags:
  CompilationDatabase: build

---
If:
  PathMatch: '.*\.(cu|cuh)$'

CompileFlags:
  Add:
    - -x
    - cuda
    - --cuda-path=/usr/local/cuda
    - --cuda-gpu-arch=sm_89
    - -I/usr/local/cuda/include
    - -I/usr/local/cuda/include/cccl
  Remove:
    - -forward-unknown-to-host-compiler
    - -dc
    - --generate-code=*
